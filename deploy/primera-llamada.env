# Lo mínimo para la primera llamada real. Copialo a ../.env y completá lo vacío.
# Todo lo demás (Gmail, Mercado Pago, ARCA…) se suma después.

# Supabase: Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MANO_TENANT_ID=00000000-0000-0000-0000-000000000001

# Hablás con Mano por WhatsApp (el mismo número que te va a llamar)
OWNER_CHANNEL=whatsapp
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
# inventalo vos, lo cargás igual en Meta al registrar el webhook
WA_VERIFY_TOKEN=
# tu celular con código de país, sin + (ej. 5492231234567)
WA_OWNER_PHONE=
WA_TEMPLATE_NOTICE=
WA_TEMPLATE_LANG=es_AR

# Un solo proveedor para los dos niveles alcanza para probar. Precios: la tarifa vigente del modelo.
CHEAP_PROVIDER=openai
CHEAP_API_KEY=
CHEAP_MODEL=
CHEAP_PRICE_IN=
CHEAP_PRICE_OUT=
TOP_PROVIDER=openai
TOP_API_KEY=
TOP_MODEL=
TOP_PRICE_IN=
TOP_PRICE_OUT=

# Voz en tiempo real
VOICE_ENABLED=true
REALTIME_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_PRICE_IN=
REALTIME_PRICE_OUT=

# Topes de gasto bajos para la prueba
CAP_DAY_USD=2
CAP_MONTH_USD=10

PUBLIC_URL=https://mano.tudominio.com
PORT=8787
TZ=America/Argentina/Buenos_Aires
