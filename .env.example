# ─── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Fase 0 es mono-tenant: el UUID del tenant que crea supabase/seed.sql
MANO_TENANT_ID=00000000-0000-0000-0000-000000000001

# ─── Telegram ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Tu chat id (mandale /start al bot y lo muestra). Solo este chat puede hablarle.
TELEGRAM_OWNER_CHAT_ID=

# ─── Modelos: ruteo en cascada ──────────────────────────────
# "cheap" = triage y resúmenes. "top" = decidir, redactar, programar.
# provider: anthropic | openai-compatible (DeepSeek, OpenAI, OpenRouter, Ollama…)
CHEAP_PROVIDER=openai-compatible
CHEAP_BASE_URL=https://api.deepseek.com
CHEAP_API_KEY=
CHEAP_MODEL=deepseek-flash
# USD por millón de tokens (deepseek-flash, tarifa pico, oct 2026 — verificar)
CHEAP_PRICE_IN=0.3
CHEAP_PRICE_OUT=1.2

TOP_PROVIDER=anthropic
TOP_API_KEY=
TOP_MODEL=claude-sonnet-5-5
# Completar con la página de precios del proveedor; sin esto el gobernador no arranca
TOP_PRICE_IN=
TOP_PRICE_OUT=

# Transcripción de audios (endpoint compatible con OpenAI /audio/transcriptions). Opcional.
# Ej.: https://api.openai.com/v1 con whisper-1, o un Whisper propio en el VPS.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# ─── Gobernador de gasto (USD) ──────────────────────────────
CAP_DAY_USD=3
CAP_MONTH_USD=40

# ─── Gmail (OAuth del dueño, Fase 0) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Topic de Pub/Sub para notificaciones push: projects/<proyecto>/topics/<topic>
GMAIL_PUBSUB_TOPIC=
# Token compartido que Pub/Sub manda en ?token= para validar el webhook
GMAIL_PUSH_TOKEN=

# ─── Worker (Go) ────────────────────────────────────────────
PORT=8787
TZ=America/Argentina/Buenos_Aires
# Hora local del resumen diario (HH:MM)
BRIEF_AT=07:00
