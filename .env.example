# ─── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Fase 0 es mono-tenant: el UUID del tenant que crea supabase/seed.sql
MANO_TENANT_ID=00000000-0000-0000-0000-000000000001

# ─── Canal del dueño ────────────────────────────────────────
# Por dónde te habla Mano: telegram | whatsapp. El otro, si está configurado, queda de respaldo.
OWNER_CHANNEL=telegram

# ─── Telegram (opcional si usás WhatsApp) ───────────────────
TELEGRAM_BOT_TOKEN=
# Tu chat id (mandale /start al bot y lo muestra). Solo este chat puede hablarle.
TELEGRAM_OWNER_CHAT_ID=

# ─── WhatsApp Cloud API (opcional si usás Telegram) ─────────
# Meta for Developers → tu app → WhatsApp → API Setup
WA_PHONE_NUMBER_ID=
# Token de usuario de sistema (permanente), nunca el temporal de 24 h
WA_ACCESS_TOKEN=
# App secret: valida la firma X-Hub-Signature-256 de cada webhook
WA_APP_SECRET=
# Texto que inventás vos y cargás en Meta al registrar https://TU-WORKER/webhooks/whatsapp
WA_VERIFY_TOKEN=
# Tu número personal con código de país, sin + (ej. 5492231234567). Los demás son clientes.
WA_OWNER_PHONE=
# Plantilla utility para avisarte fuera de la ventana de 24 h (ver README). Vacía = respaldo por Telegram.
WA_TEMPLATE_NOTICE=mano_aviso
WA_TEMPLATE_LANG=es_AR
WA_API_VERSION=v26.0

# ─── Notas de voz (opcional) ────────────────────────────────
# Lo importante te llega como audio (Telegram o WhatsApp). Endpoint compatible con OpenAI /audio/speech.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin
# USD por millón de caracteres (tarifa vigente; obligatorio si configurás TTS_BASE_URL)
TTS_PRICE_PER_M_CHARS=

# ─── Llamadas de voz: Mano te llama (opcional, requiere WhatsApp) ─
# Cuando algo es crítico te llama por WhatsApp, te cuenta y decidís hablando.
VOICE_ENABLED=false
# Voz en tiempo real (OpenAI Realtime o compatible: POST /realtime/calls por WebRTC)
REALTIME_BASE_URL=https://api.openai.com/v1
REALTIME_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
# Transcribe lo que decís para el registro de la llamada
REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# USD por millón de tokens de audio (tarifa vigente del modelo; sin esto el worker no arranca con voz)
REALTIME_PRICE_IN=
REALTIME_PRICE_OUT=
# Llamada máxima y cuánto deja sonar antes de cortar
CALL_MAX_SECONDS=300
CALL_RING_SECONDS=45
# Tarifa de Meta por minuto saliente a tu país (Argentina, oct 2026 — verificar)
WA_CALL_USD_PER_MIN=0.0101
# Plantilla utility con el componente call_permission_request, para pedir permiso fuera de la ventana. Opcional.
WA_TEMPLATE_CALL_PERMISSION=
# STUN para que WebRTC descubra la IP pública del VPS
STUN_URL=stun:stun.l.google.com:19302

# ─── Modelos: ruteo en cascada ──────────────────────────────
# "cheap" = triage y resúmenes. "top" = decidir, redactar, programar.
# provider: anthropic, openai, gemini, deepseek, openrouter, groq, mistral, xai, together, fireworks, cerebras, ollama
#           u openai-compatible + BASE_URL para cualquier otro. Con el nombre, la URL se completa sola.
CHEAP_PROVIDER=deepseek
CHEAP_BASE_URL=
CHEAP_API_KEY=
CHEAP_MODEL=deepseek-flash
# USD por millón de tokens (deepseek-flash, tarifa pico, oct 2026 — verificar)
CHEAP_PRICE_IN=0.3
CHEAP_PRICE_OUT=1.2

TOP_PROVIDER=anthropic
TOP_API_KEY=
TOP_MODEL=claude-sonnet-5-5
# Completar con la página de precios del proveedor; sin esto el gobernador no arranca
TOP_PRICE_IN=
TOP_PRICE_OUT=

# Memoria con búsqueda (opcional): "¿qué me dijo Pérez del contrato?". Embeddings de 1024 dimensiones.
# Ej.: EMBED_PROVIDER=openai, EMBED_MODEL=text-embedding-3-small (acepta dimensions=1024). Sin esto, busca por palabras.
EMBED_PROVIDER=
EMBED_MODEL=
EMBED_API_KEY=
EMBED_BASE_URL=
# USD por millón de tokens (tarifa vigente)
EMBED_PRICE=

# Respaldo (opcional): si el proveedor de cualquiera de los dos niveles falla (caído, sin cupo, sin saldo),
# Mano usa este modelo en vez de quedarse sin IA. Conviene uno de OTRO proveedor.
FALLBACK_PROVIDER=
FALLBACK_MODEL=
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_PRICE_IN=
FALLBACK_PRICE_OUT=

# Transcripción de audios (endpoint compatible con OpenAI /audio/transcriptions). Opcional.
# Ej.: https://api.openai.com/v1 con whisper-1, o un Whisper propio en el VPS.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# ─── Gobernador de gasto (USD) ──────────────────────────────
CAP_DAY_USD=3
CAP_MONTH_USD=40

# ─── Gmail (OAuth del dueño, Fase 0) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Topic de Pub/Sub para notificaciones push: projects/<proyecto>/topics/<topic>
GMAIL_PUBSUB_TOPIC=
# Inbox limpio: archivar solo lo que se ignora (newsletters, automáticos). Reversible con /desarchivar.
# Requiere el scope gmail.modify en el refresh token.
GMAIL_ARCHIVE_IGNORED=false
# Token compartido que Pub/Sub manda en ?token= para validar el webhook
GMAIL_PUSH_TOKEN=

# ─── Google Calendar (opcional) ─────────────────────────────
# Usa el mismo OAuth de Gmail: el refresh token tiene que incluir el scope calendar.readonly.
CALENDAR_ENABLED=false
# URL https pública del worker (Google solo manda push a https con certificado válido)
PUBLIC_URL=https://mano.tudominio.com
# Texto que inventás vos: Google lo manda en cada aviso y el worker lo valida
CALENDAR_PUSH_TOKEN=

# ─── Mercado Pago (opcional) ────────────────────────────────
# Tus integraciones → credenciales de producción. Webhook: https://TU-WORKER/webhooks/mercadopago, evento "Pagos".
MP_ACCESS_TOKEN=
# Clave secreta que muestra Mercado Pago al configurar el webhook (valida x-signature)
MP_WEBHOOK_SECRET=

# Transferencias salientes (Payouts). APAGADAS por defecto: Mercado Pago tiene que habilitarlas
# para tu cuenta y registrar tu clave pública Ed25519 (ver README).
MP_PAYOUTS_ENABLED=false
# Clave privada Ed25519 (PEM PKCS#8): openssl genpkey -algorithm ed25519 -out mp_payouts.pem
MP_PAYOUTS_KEY_FILE=
# true = cuenta de prueba (sin firma). Nunca en producción.
MP_PAYOUTS_TEST=false
# Topes duros en pesos, además de aprobar cada una con el botón
MP_PAYOUT_MAX_ARS=500000
MP_PAYOUT_DAY_MAX_ARS=1000000

# ─── Mercado Libre: ventas y envíos (opcional) ──────────────
# App en developers.mercadolibre.com.ar. Notificaciones: https://TU-WORKER/webhooks/mercadolibre, tópicos orders_v2 y shipments.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Refresh token del vendedor (autorizá la app con el scope offline_access). Se usa solo la primera vez:
# es de un solo uso y Mano guarda el nuevo en la base en cada renovación.
ML_REFRESH_TOKEN=

# ─── ARCA: facturación electrónica (opcional) ───────────────
# CUIT del negocio (11 dígitos). Con esto se activa.
ARCA_CUIT=
# homologacion (pruebas) | produccion
ARCA_ENV=homologacion
# Certificado que da ARCA (PEM) y la clave privada con la que pediste el CSR
ARCA_CERT_FILE=
ARCA_KEY_FILE=
# Punto de venta de tipo "Web Services" (lo das de alta en ARCA)
ARCA_PTO_VTA=
# 1 productos, 2 servicios, 3 ambos
ARCA_CONCEPTO=2
# Proponer la factura al acreditarse un pago de Mercado Pago (true|false)
ARCA_AUTO=true
# Desde este monto ARCA exige identificar al consumidor final (verificar el valor vigente)
ARCA_CF_MAX=10000000

# ─── Panel web ──────────────────────────────────────────────
# Contraseña para entrar al panel. Sin esto el panel no abre (mejor cerrado que expuesto).
PANEL_PASSWORD=
# Token compartido entre panel y worker para decidir aprobaciones desde la web: openssl rand -hex 24
PANEL_TOKEN=
# Dónde escucha el worker, visto desde el panel
WORKER_URL=http://localhost:8787

# ─── Worker (Go) ────────────────────────────────────────────
PORT=8787
TZ=America/Argentina/Buenos_Aires
# Hora local del resumen diario (HH:MM)
BRIEF_AT=07:00
# Recordatorios de turnos de mañana por WhatsApp (con una aprobación por tanda). Vacío = apagados.
# Necesita Calendar y WhatsApp. Fuera de la ventana de 24 h usa la plantilla (utility, es_AR):
#   "Hola {{1}}, te recordamos tu turno del {{2}} a las {{3}}. Si no podés venir, avisanos por acá."
REMINDERS_AT=
WA_TEMPLATE_REMINDER=
# Cierre del día: qué hizo Mano y qué queda (sin IA). Vacío = no se manda.
BRIEF_CLOSE_AT=19:00
