# ─── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Fase 0 es mono-tenant: el UUID del tenant que crea supabase/seed.sql
MANO_TENANT_ID=00000000-0000-0000-0000-000000000001

# ─── Canal del dueño ────────────────────────────────────────
# Por dónde te habla Mano: telegram | whatsapp. El otro, si está configurado, queda de respaldo.
OWNER_CHANNEL=telegram

# ─── Telegram (opcional si usás WhatsApp) ───────────────────
TELEGRAM_BOT_TOKEN=
# Tu chat id (mandale /start al bot y lo muestra). Solo este chat puede hablarle.
TELEGRAM_OWNER_CHAT_ID=

# ─── WhatsApp Cloud API (opcional si usás Telegram) ─────────
# Meta for Developers → tu app → WhatsApp → API Setup
WA_PHONE_NUMBER_ID=
# Token de usuario de sistema (permanente), nunca el temporal de 24 h
WA_ACCESS_TOKEN=
# App secret: valida la firma X-Hub-Signature-256 de cada webhook
WA_APP_SECRET=
# Texto que inventás vos y cargás en Meta al registrar https://TU-WORKER/webhooks/whatsapp
WA_VERIFY_TOKEN=
# Tu número personal con código de país, sin + (ej. 5492231234567). Los demás son clientes.
WA_OWNER_PHONE=
# Plantilla utility para avisarte fuera de la ventana de 24 h (ver README). Vacía = respaldo por Telegram.
WA_TEMPLATE_NOTICE=mano_aviso
WA_TEMPLATE_LANG=es_AR
WA_API_VERSION=v26.0

# ─── Llamadas de voz: Mano te llama (opcional, requiere WhatsApp) ─
# Cuando algo es crítico te llama por WhatsApp, te cuenta y decidís hablando.
VOICE_ENABLED=false
# Voz en tiempo real (OpenAI Realtime o compatible: POST /realtime/calls por WebRTC)
REALTIME_BASE_URL=https://api.openai.com/v1
REALTIME_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
# Transcribe lo que decís para el registro de la llamada
REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# USD por millón de tokens de audio (tarifa vigente del modelo; sin esto el worker no arranca con voz)
REALTIME_PRICE_IN=
REALTIME_PRICE_OUT=
# Llamada máxima y cuánto deja sonar antes de cortar
CALL_MAX_SECONDS=300
CALL_RING_SECONDS=45
# Tarifa de Meta por minuto saliente a tu país (Argentina, oct 2026 — verificar)
WA_CALL_USD_PER_MIN=0.0101
# Plantilla utility con el componente call_permission_request, para pedir permiso fuera de la ventana. Opcional.
WA_TEMPLATE_CALL_PERMISSION=
# STUN para que WebRTC descubra la IP pública del VPS
STUN_URL=stun:stun.l.google.com:19302

# ─── Modelos: ruteo en cascada ──────────────────────────────
# "cheap" = triage y resúmenes. "top" = decidir, redactar, programar.
# provider: anthropic | openai-compatible (DeepSeek, OpenAI, OpenRouter, Ollama…)
CHEAP_PROVIDER=openai-compatible
CHEAP_BASE_URL=https://api.deepseek.com
CHEAP_API_KEY=
CHEAP_MODEL=deepseek-flash
# USD por millón de tokens (deepseek-flash, tarifa pico, oct 2026 — verificar)
CHEAP_PRICE_IN=0.3
CHEAP_PRICE_OUT=1.2

TOP_PROVIDER=anthropic
TOP_API_KEY=
TOP_MODEL=claude-sonnet-5-5
# Completar con la página de precios del proveedor; sin esto el gobernador no arranca
TOP_PRICE_IN=
TOP_PRICE_OUT=

# Transcripción de audios (endpoint compatible con OpenAI /audio/transcriptions). Opcional.
# Ej.: https://api.openai.com/v1 con whisper-1, o un Whisper propio en el VPS.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# ─── Gobernador de gasto (USD) ──────────────────────────────
CAP_DAY_USD=3
CAP_MONTH_USD=40

# ─── Gmail (OAuth del dueño, Fase 0) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Topic de Pub/Sub para notificaciones push: projects/<proyecto>/topics/<topic>
GMAIL_PUBSUB_TOPIC=
# Token compartido que Pub/Sub manda en ?token= para validar el webhook
GMAIL_PUSH_TOKEN=

# ─── Worker (Go) ────────────────────────────────────────────
PORT=8787
TZ=America/Argentina/Buenos_Aires
# Hora local del resumen diario (HH:MM)
BRIEF_AT=07:00
